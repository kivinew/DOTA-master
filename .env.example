# DOTA_MASTER — Environment Variables
# Copy to .env and adjust values as needed

# OpenDota account ID (SteamID32) - default: 41099157
DOTA_ACCOUNT_ID=41099157

# SteamID64 for vanity URL resolution - default: 76561198001364885
DOTA_STEAM_ID64=76561198001364885

# Web server port - default: 9999
PORT=9999

# Auto-update interval in seconds - default: 300 (5 minutes)
DOTA_UPDATE_INTERVAL=300

# Maximum matches to fetch per update - default: 100
DOTA_MAX_MATCHES=100

# Flask secret key (auto-generated if not set, sessions will reset on restart)
# DOTA_MASTER_SECRET=your-secret-key-here

# Steam API key for vanity URL resolution (optional, needed for main.py fetch with vanity URL)
# STEAM_API_KEY=your-steam-api-key